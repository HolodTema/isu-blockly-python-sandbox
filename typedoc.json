{
  "entryPoints": ["src/shared", "src/entities", "src/features"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "tsconfig": "tsconfig.app.json",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/worker/**/*",
    "src/test/**/*"
  ],
  "readme": "none",
  "githubPages": false,
  "excludePrivate": true,
  "excludeInternal": true
}

